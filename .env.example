# OpsPilot AI — local development environment.
# Copy to .env:  cp .env.example .env
# Never commit .env. Values below are for the local Docker Compose stack only.

# Local-only signing secret. The API refuses to start with this value outside environment=local.
OPSPILOT_JWT_SECRET=local-dev-only-insecure-jwt-secret-change-me-0001

# Optional: enables grounded answer generation and the agent. Without it, retrieval,
# ingestion and search still work and the UI reports generation as unavailable.
ANTHROPIC_API_KEY=

# Optional: GitHub token for repository documentation ingestion / GitHub MCP server
# (fine-grained, read-only "Contents" + "Metadata" on selected repositories).
GITHUB_TOKEN=

# Password for the seeded demo users (admin@opspilot.demo, sre@, engineer@, viewer@). Local only.
OPSPILOT_DEMO_PASSWORD=opspilot-demo-password

# Local infrastructure credentials (Docker Compose only)
POSTGRES_PASSWORD=opspilot-local
S3_ACCESS_KEY=opspilot
S3_SECRET_KEY=opspilot-local-secret

# Optional OpenTelemetry collector endpoint, e.g. http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Demo environment control plane (local only). Read: observability/ops reads. Deploy: held only by the
# operations MCP server. Admin: scenario trigger/reset, held only by the API for admins.
CONTROL_PLANE_READ_TOKEN=local-demo-control-plane-read-token
CONTROL_PLANE_DEPLOY_TOKEN=local-demo-control-plane-deploy-token
CONTROL_PLANE_ADMIN_TOKEN=local-demo-control-plane-admin-token

# Ed25519 key pair for MCP tool tokens (base64 raw). The API signs; MCP servers verify with the public key.
# PUBLISHED LOCAL-ONLY PAIR (refused outside environment=local). Generate your own: python -m opspilot.cli gen-mcp-keys
OPSPILOT_MCP_SIGNING_PRIVATE_KEY=bG9jYWwtZGV2LW9ubHktb3BzcGlsb3QtbWNwLWtleSE=
OPSPILOT_MCP_VERIFY_PUBLIC_KEY=w09lOp4oszP5+QrYUQbCU0ndyTwCe+anvTf4zrLDVKQ=
